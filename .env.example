# agent-compose 설정 예시 — 실제 값은 .env(gitignore)로 복사해 채운다.
# 하드코딩 금지: 모든 배포별 값은 여기(.env) 경유. 접속정보·IP 는 placeholder 로만.

## 서버 바인딩(API 리슨)
APP_HOST=127.0.0.1
APP_PORT=8084          # vision3(8083)·vLLM(8000~8003)과 충돌 회피

## chat LLM (선곡·끝보정·검수 — text)
LLM_BASE_URL=http://<gpu-host>:8002/v1
LLM_MODEL=qwen
LLM_TIMEOUT=240.0
LLM_THINKING=1

## embedding (색인·질의)
EMBED_BASE_URL=http://<gpu-host>:8003/v1
EMBED_MODEL=qwen-embed
EMBED_BATCH=64

## worker-render (하이라이트 mp4 렌더링 — 동기 호출)
RENDER_BASE_URL=http://<gpu-host>:8003
RENDER_TIMEOUT=600.0
RENDER_POLL_INTERVAL=5.0

## Milvus (원격 — localhost 미러는 개발 전용)
MILVUS_URI=http://<db-host>:19530
MILVUS_DB=sm_db
MILVUS_COLLECTION=sm_scene_evidence
VECTOR_TOP_K=20

## DB (MariaDB)
DB_IP=<db-host>
DB_PORT=13306
DB_USER=sm_db
DB_PW=<password>
DB_NAME=sm_db
DB_POOL_MAX=30
DB_POOL_RECYCLE=240

## logging
LOG_LEVEL=INFO
LOG_PATH=logs/agent-compose.log
