# agent-compose 설정 예시 — 실제 값은 .env(gitignore)로 복사해 채운다.
# 하드코딩 금지: 모든 배포별 값은 여기(.env) 경유. 접속정보·호스트·포트는 placeholder 로만.

## 서버 바인딩(API 리슨)
APP_HOST=127.0.0.1
APP_PORT=<port>

## DB (MariaDB)
DB_IP=<db-host>
DB_PORT=<port>
DB_USER=sm_db
DB_PW=<password>
DB_NAME=sm_db
DB_POOL_MAX=30
DB_POOL_RECYCLE=240    # NAT 경유 환경은 짧게

## chat LLM (질의 해석·선곡 — openai 호환 /v1/chat/completions)
LLM_BASE_URL=http://<host>:<port>/v1
LLM_MODEL=qwen
LLM_TIMEOUT=600.0      # 전송 상한 — thinking 시간 가드보다 커야 한다
LLM_CONCURRENCY=12     # 동시 전송 상한 — 서버 --max-num-seqs 와 맞춘다
LLM_THINKING=1         # 전역 thinking 스위치 — 끄면 전 콜 비활성 (켜는 콜은 코드 소유)
# thinking 콜의 사고량 — low | medium | xhigh (빈 값/미설정이면 enable_thinking 토글 방식)
LLM_REASONING_EFFORT=low
SELECT_TOKENS_MAX=5000 # 선곡 콜 입력 토큰 상한 — 초과 시 맵-리듀스 분기
BUDGET_MARGIN=0.1      # 예산 여유율 — 허용 상한 = budget_sec × (1 + 여유율)

## embedding (질의 임베딩 — agent-vision 색인과 같은 서버·모델이어야 한다)
EMBED_BASE_URL=http://<host>:<port>/v1
EMBED_MODEL=qwen-embed
EMBED_TIMEOUT=60.0

## Milvus (증거 색인 — 쓰기는 agent-vision 소유)
MILVUS_URI=http://<host>:<port>
MILVUS_DB=sm_db
MILVUS_COLLECTION=sm_sport_baseball
VECTOR_TOP_K=50

## worker-render (편성 → mp4 렌더링 — GPU 워커)
RENDER_BASE_URL=http://<host>:<port>
RENDER_TIMEOUT=600.0
RENDER_POLL_INTERVAL=5.0

## logging
LOG_LEVEL=INFO
LOG_PATH=logs/agent-compose.log

## LLM 트레이스 — 실행마다 {v_id}_{comp_id}/ 디렉터리에 노드별 md. 빈 값이면 끔
TRACE_DIR=logs
